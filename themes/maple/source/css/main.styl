@import 'highlight.styl'


:root {
  --c-bg: #f4f1e8
  --c-surface: #ebe7dc
  --c-surface-hover: #e2ddd0
  --c-text: #3f433f
  --c-muted: #747970
  --c-border: #d8d2c4
  --c-accent: #9a5f3f
  --c-accent-soft: #ead8ca
  --c-header: rgba(244, 241, 232, .86)
  --c-menu: rgba(244, 241, 232, .95)
  --c-scrollbar: #c8c1b3
  --c-scrollbar-hover: #aaa294
}

html.dark
  --c-bg: #1e1e2e
  --c-surface: #313244
  --c-surface-hover: #45475a
  --c-text: #cdd6f4
  --c-muted: #a6adc8
  --c-border: #45475a
  --c-accent: #cba6f7
  --c-accent-soft: #3b314d
  --c-header: rgba(30, 30, 46, .86)
  --c-menu: rgba(30, 30, 46, .95)
  --c-scrollbar: #45475a
  --c-scrollbar-hover: #6c7086

body.theme-body
  background-color: var(--c-bg)
  color: var(--c-text)
  transition: background-color .25s ease, color .25s ease

.theme-header
  background-color: var(--c-header)
  border-color: var(--c-border)

.theme-menu
  background-color: var(--c-menu)

.theme-footer,
.theme-muted
  color: var(--c-muted)

.theme-border
  border-color: var(--c-border)

.theme-tag
  background-color: var(--c-surface)

.theme-tag:hover
  background-color: var(--c-surface-hover)

.theme-back-to-top
  background-color: var(--c-surface-hover)
  color: var(--c-text)

.post-content.prose
  --tw-prose-body: var(--c-text)
  --tw-prose-headings: var(--c-text)
  --tw-prose-lead: var(--c-muted)
  --tw-prose-links: var(--c-accent)
  --tw-prose-bold: var(--c-text)
  --tw-prose-counters: var(--c-muted)
  --tw-prose-bullets: var(--c-muted)
  --tw-prose-hr: var(--c-border)
  --tw-prose-quotes: var(--c-text)
  --tw-prose-quote-borders: var(--c-accent)
  --tw-prose-captions: var(--c-muted)
  --tw-prose-code: var(--c-text)
  --tw-prose-th-borders: var(--c-border)
  --tw-prose-td-borders: var(--c-border)

a:hover
  color: var(--c-accent)
  cursor: pointer

::-webkit-scrollbar-track
  background-color: var(--c-bg);


::-webkit-scrollbar
  width: 6px;
  height: 6px;


::-webkit-scrollbar-thumb
    background-color: var(--c-scrollbar);
    border-radius: 4px;

::-webkit-scrollbar-thumb:hover
  background-color: var(--c-scrollbar-hover)

.maple
  position: absolute;
  width: 24px;
  height: 24px;
  top: 0px;
  left: 0px;
  background-image: url(../img/logo.svg);
  background-size: cover;
  will-change: transform;

#maple
  z-index: 40
  overflow: hidden


@keyframes fall
  0%
    transform: translate(0px, 0px);

  100%
    transform: translate(calc(100vw * var(--maple-fall-offset)), var(--maple-fall-height));


.toc-list
  li
    margin-bottom: 0.3rem

  ol
    margin-top: 0.3rem

.back-to-top
  -webkit-transform: translateZ(0)
  transition-property: bottom
  transition-duration: 0.2s
  transition-timing-function: ease-in-out
  transition-delay: 0s

.back-to-top.back-to-top-on
  bottom: 30px

@keyframes enter
  0%
    opacity: 0
    transform: translateY(10px)

  to
    opacity: 1
    transform: none

[data-animate]
  --stagger: 0
  --delay: 120ms
  --start: 0ms

@media (prefers-reduced-motion:no-preference)
  [data-animate]
    animation: enter .6s both
    animation-delay: calc(var(--stagger) * var(--delay) + var(--start))

[data-animation-controller=false] [data-animate]
  animation: none;

.slide-enter-content
  counter-reset: enter-count

.slide-enter-content > *
  --stagger: 0
  --delay: 150ms
  --start: 0ms
  animation: enter 1s both 1
  animation-delay: calc(var(--start) + var(--stagger) * var(--delay))

.slide-enter-content > p
  counter-increment: enter-count
  --stagger: counter(enter-count)


/* view-transition */
::view-transition-old(root),
::view-transition-new(root)
  animation: none
  mix-blend-mode: normal

::view-transition-old(root)
  z-index: 1

::view-transition-new(root)
  z-index: 9999

.dark::view-transition-old(root)
  z-index: 9999

.dark::view-transition-new(root)
  z-index: 1
.category-tree
  > .category-list
    display: grid
    gap: 0.75rem

  .category-list-item
    display: grid
    grid-template-columns: 1.5rem minmax(0, 1fr) auto
    align-items: center
    column-gap: 0.5rem
    padding: 0.75rem 1rem
    border: 1px solid var(--c-border)
    border-radius: 0.75rem
    background: var(--c-surface)

  .category-list-link
    grid-column: 2
    min-width: 0
    font-weight: 600

  .category-list-count,
  .category-count
    grid-column: 3
    padding: 0.15rem 0.55rem
    border-radius: 9999px
    background: var(--c-accent-soft)
    color: var(--c-accent)
    font-size: 0.75rem
    line-height: 1.5
    white-space: nowrap

  .category-list-count::after
    content: ' 篇'

  .category-toggle
    grid-column: 1
    grid-row: 1
    width: 1.5rem
    height: 1.5rem
    display: inline-flex
    align-items: center
    justify-content: center
    border-radius: 0.375rem
    color: var(--c-muted)

  .category-toggle:hover
    background: var(--c-surface-hover)
    color: var(--c-accent)

  .category-toggle span
    font-size: 1.35rem
    line-height: 1
    transition: transform 0.2s ease

  .is-open > .category-toggle span
    transform: rotate(90deg)

  .category-list-child
    grid-column: 1 / -1
    margin: 0.75rem 0 0 1.5rem
    display: grid
    gap: 0.5rem

  .category-list-child[hidden]
    display: none

  .category-list-child .category-list-item
    background: var(--c-bg)

.empty-category-list
  display: grid
  gap: 0.75rem
  margin-top: 0.75rem

.empty-category-item
  display: grid
  grid-template-columns: 1.5rem minmax(0, 1fr) auto
  align-items: center
  column-gap: 0.5rem
  padding: 0.75rem 1rem
  border: 1px solid var(--c-border)
  border-radius: 0.75rem

.empty-category-name
  grid-column: 2

.empty-category-item .category-count
  grid-column: 3
  padding: 0.15rem 0.55rem
  border-radius: 9999px
  background: var(--c-surface)
  font-size: 0.75rem
  line-height: 1.5

.tag-grid
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 0.75rem

.tag-card
  min-height: 3.25rem
  display: flex
  align-items: center
  justify-content: space-between
  gap: 0.75rem
  padding: 0.75rem 1rem
  border: 1px solid var(--c-border)
  border-radius: 0.75rem
  background: var(--c-surface)
  transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease

.tag-card:hover
  border-color: var(--c-accent)
  background: var(--c-surface-hover)
  transform: translateY(-1px)

.tag-name
  min-width: 0
  overflow-wrap: anywhere
  font-weight: 600

.tag-count
  flex: none
  padding: 0.15rem 0.55rem
  border-radius: 9999px
  background: var(--c-accent-soft)
  color: var(--c-accent)
  font-size: 0.75rem
  line-height: 1.5
  white-space: nowrap

.pagination
  display: flex
  justify-content: center
  align-items: center
  gap: 0.5rem
  margin: 1rem 0 3rem
  flex-wrap: wrap

  .page-number,
  .extend,
  .space
    min-width: 2.25rem
    height: 2.25rem
    padding: 0 0.7rem
    display: inline-flex
    align-items: center
    justify-content: center
    border-radius: 0.6rem

  a
    border: 1px solid var(--c-border)
    transition: border-color 0.2s ease, transform 0.2s ease

  a:hover
    border-color: var(--c-accent)
    transform: translateY(-1px)

  .current
    color: #fff
    background: var(--c-accent)

@media (max-width: 640px)
  .tag-grid
    grid-template-columns: minmax(0, 1fr)
